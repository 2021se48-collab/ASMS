<svg class="@SvgClass"
     viewBox="0 0 24 24"
     fill="none"
     stroke="currentColor"
     stroke-width="var(--icon-stroke-width)"
     stroke-linecap="round"
     stroke-linejoin="round"
     role="@(string.IsNullOrWhiteSpace(Label) ? null : "img")"
     aria-label="@Label"
     aria-hidden="@(string.IsNullOrWhiteSpace(Label) ? "true" : null)">
    @switch (Name)
    {
        case IconName.Dashboard:
            <rect x="3" y="3" width="8" height="8" />
            <rect x="13" y="3" width="8" height="5" />
            <rect x="13" y="10" width="8" height="11" />
            <rect x="3" y="13" width="8" height="8" />
            break;
        case IconName.Students:
            <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2" />
            <circle cx="9" cy="7" r="4" />
            <path d="M22 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75" />
            break;
        case IconName.Teachers:
            <circle cx="12" cy="8" r="4" />
            <path d="M5 21a7 7 0 0 1 14 0M19 8h3m-1.5-1.5v3" />
            break;
        case IconName.Classes:
            <path d="M3 5.5A2.5 2.5 0 0 1 5.5 3H20v17H5.5A2.5 2.5 0 0 1 3 17.5z" />
            <path d="M3 17.5A2.5 2.5 0 0 1 5.5 15H20M8 7h8m-8 4h6" />
            break;
        case IconName.Subjects:
            <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z" />
            <path d="M8 7h8m-8 4h8" />
            break;
        case IconName.Calendar:
            <rect x="3" y="5" width="18" height="16" rx="2" />
            <path d="M16 3v4M8 3v4M3 10h18" />
            break;
        case IconName.Attendance:
            <rect x="4" y="3" width="16" height="18" rx="2" />
            <path d="M8 3.5h8M8 12l2.5 2.5L16 9" />
            break;
        case IconName.Exams:
            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z" />
            <path d="M14 2v6h6M8 13h8m-8 4h8" />
            break;
        case IconName.Results:
            <path d="M3 3v18h18" />
            <path d="M7 14h3v4H7zm6-6h3v10h-3zm6-4h3v14h-3z" />
            break;
        case IconName.Fees:
            <circle cx="12" cy="12" r="9" />
            <path d="M16 8.5c-.7-.7-1.7-1-3-1-1.7 0-3 1-3 2.5s1.3 2.2 3 2.5 3 1 3 2.5-1.3 2.5-3 2.5c-1.2 0-2.3-.4-3-1M13 5v14" />
            break;
        case IconName.Payments:
            <rect x="2" y="5" width="20" height="14" rx="2" />
            <path d="M2 10h20m-16 5h4" />
            break;
        case IconName.Expenses:
            <path d="M5 3h14v18l-3.5-2-3.5 2-3.5-2L5 21z" />
            <path d="M9 8h6m-6 4h6" />
            break;
        case IconName.Library:
            <path d="M4 4h4v16H4zm6-1h4v17h-4zm6 2h4v15h-4z" />
            <path d="M5 8h2m4 0h2m4 1h2" />
            break;
        case IconName.Inventory:
            <path d="m3 7 9-4 9 4-9 4zM3 7v10l9 4 9-4V7M12 11v10" />
            <path d="m7.5 5 9 4M7 14l2 1m6 2 2-1" />
            break;
        case IconName.Reports:
            <path d="M4 19V5m0 14h17" />
            <path d="m7 15 4-4 3 2 5-6" />
            <circle cx="7" cy="15" r="1" />
            <circle cx="11" cy="11" r="1" />
            <circle cx="14" cy="13" r="1" />
            <circle cx="19" cy="7" r="1" />
            break;
        case IconName.Settings:
            <path d="M12 8.5a3.5 3.5 0 1 0 0 7 3.5 3.5 0 0 0 0-7z" />
            <path d="m19.4 15 .1.1 1.4 1.1-1.4 2.4-1.7-.7a8 8 0 0 1-1.7 1l-.3 1.8h-2.8l-.3-1.8a8 8 0 0 1-1.7-1l-1.7.7-1.4-2.4 1.4-1.1a7 7 0 0 1 0-2l-1.4-1.1 1.4-2.4 1.7.7a8 8 0 0 1 1.7-1l.3-1.8h2.8l.3 1.8a8 8 0 0 1 1.7 1l1.7-.7 1.4 2.4-1.4 1.1a7 7 0 0 1-.1 2z" />
            break;
        case IconName.Search:
            <circle cx="11" cy="11" r="7" />
            <path d="m20 20-4-4" />
            break;
        case IconName.Bell:
            <path d="M18 8a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9" />
            <path d="M10 21h4" />
            break;
        case IconName.User:
            <circle cx="12" cy="8" r="4" />
            <path d="M4 21a8 8 0 0 1 16 0" />
            break;
        case IconName.Logout:
            <path d="M10 17l5-5-5-5m5 5H3" />
            <path d="M12 3h6a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-6" />
            break;
        case IconName.Plus:
            <path d="M12 5v14m-7-7h14" />
            break;
        case IconName.Edit:
            <path d="m15 5 4 4M4 20l4-.8L19 8a2.8 2.8 0 0 0-4-4L4 15z" />
            break;
        case IconName.Trash:
            <path d="M3 6h18m-2 0-.9 14H5.9L5 6m3 0V4h8v2m-6 4v6m4-6v6" />
            break;
        case IconName.Filter:
            <path d="M3 4h18l-7 8v6l-4 2v-8z" />
            break;
        case IconName.Chevron:
            <path d="m9 18 6-6-6-6" />
            break;
        case IconName.Menu:
            <path d="M4 6h16M4 12h16M4 18h16" />
            break;
        case IconName.Sun:
            <circle cx="12" cy="12" r="4" />
            <path d="M12 2v2m0 16v2M4.93 4.93l1.42 1.42m11.3 11.3 1.42 1.42M2 12h2m16 0h2M4.93 19.07l1.42-1.42m11.3-11.3 1.42-1.42" />
            break;
        case IconName.Moon:
            <path d="M20.5 14.5A8.5 8.5 0 0 1 9.5 3.5 8.5 8.5 0 1 0 20.5 14.5z" />
            break;
        case IconName.Check:
            <path d="m5 12 4 4L19 6" />
            break;
        case IconName.Alert:
            <path d="m10.3 3.9-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.7-3.1l-8-14a2 2 0 0 0-3.4 0z" />
            <path d="M12 9v4m0 4h.01" />
            break;
        case IconName.Info:
            <circle cx="12" cy="12" r="9" />
            <path d="M12 11v5m0-8h.01" />
            break;
        case IconName.Close:
            <path d="m18 6-12 12M6 6l12 12" />
            break;
    }
</svg>

@code {
    [Parameter]
    public IconName Name { get; set; }

    [Parameter]
    public IconSize Size { get; set; } = IconSize.Medium;

    [Parameter]
    public bool Directional { get; set; }

    [Parameter]
    public string? Label { get; set; }

    [Parameter]
    public string? Class { get; set; }

    private string SvgClass =>
        string.Join(
            ' ',
            new[]
            {
                "asms-icon",
                Size switch
                {
                    IconSize.Small => "asms-icon--small",
                    IconSize.Large => "asms-icon--large",
                    _ => "asms-icon--medium"
                },
                Directional ? "asms-icon-directional" : null,
                Class
            }.Where(value => !string.IsNullOrWhiteSpace(value)));
}
