<section class="@CssClass"
         aria-label="@(string.IsNullOrWhiteSpace(AriaLabel) ? null : AriaLabel)"
         aria-labelledby="@(string.IsNullOrWhiteSpace(AriaLabelledBy) ? null : AriaLabelledBy)">
    @ChildContent
</section>

@code {
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter]
    public string? AriaLabel { get; set; }

    [Parameter]
    public string? AriaLabelledBy { get; set; }

    [Parameter]
    public bool Interactive { get; set; }

    private string CssClass => Interactive ? "asms-card asms-card--interactive" : "asms-card";
}
