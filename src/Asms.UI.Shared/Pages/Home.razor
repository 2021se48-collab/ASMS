@page "/home"
@layout Asms.UI.Shared.Layout.AppShell

<section class="page-content dashboard-page" aria-labelledby="dashboard-heading">
    <h1 id="dashboard-heading">@Localizer["Home.Greeting"]</h1>
    <h2>@Localizer["Nav.Dashboard"]</h2>
    @if (Session.Roles.Count > 0)
    {
        <ul class="role-list" aria-label="@Localizer["Auth.Roles"]">
            @foreach (var role in Session.Roles)
            {
                <li>@Localizer[$"Role.{role}"]</li>
            }
        </ul>
    }
    <p>@Localizer["Home.ComingSoon"]</p>
</section>

@code {
    [Inject]
    private ILocalizer Localizer { get; set; } = default!;

    [Inject]
    private IAuthSession Session { get; set; } = default!;
}
