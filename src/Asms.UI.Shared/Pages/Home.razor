@page "/home"

<section class="page-content" aria-labelledby="dashboard-heading">
    <h1 id="dashboard-heading">@Localizer["Nav.Dashboard"]</h1>
    <ul class="navigation-list">
        @foreach (var key in NavigationKeys)
        {
            <li>@Localizer[key]</li>
        }
    </ul>
    <button type="button" class="action-button"
            aria-label="@Localizer["Common.Back"]"
            @onclick="ReturnToLanguageChooser">
        @Localizer["Common.Back"]
    </button>
</section>

@code {
    private static readonly string[] NavigationKeys =
    [
        "Nav.Dashboard", "Nav.Students", "Nav.Teachers", "Nav.Attendance",
        "Nav.Exams", "Nav.Fees", "Nav.Reports", "Nav.Library",
        "Nav.Inventory", "Nav.Settings"
    ];

    [Inject]
    private ILocalizer Localizer { get; set; } = default!;

    [Inject]
    private NavigationManager Navigation { get; set; } = default!;

    private void ReturnToLanguageChooser() => Navigation.NavigateTo("/");
}
