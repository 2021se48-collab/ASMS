@page "/login"
@using Microsoft.AspNetCore.Components.Forms

<section class="page-content login-page" aria-labelledby="login-heading">
    <div class="login-card card-surface">
        <header class="login-heading">
            <svg class="login-mark"
                 viewBox="0 0 48 48"
                 aria-hidden="true"
                 focusable="false">
                <path d="M24 3 43 10v12c0 11-7.8 19.2-19 23C12.8 41.2 5 33 5 22V10z"
                      fill="currentColor" />
                <path d="M13 16c4.1-1.3 7.8-.5 11 1.8 3.2-2.3 6.9-3.1 11-1.8v15c-4.1-1.3-7.8-.5-11 1.8-3.2-2.3-6.9-3.1-11-1.8z"
                      fill="none"
                      stroke="var(--color-on-primary)"
                      stroke-linejoin="round"
                      stroke-width="2" />
                <path d="M24 18v15"
                      fill="none"
                      stroke="var(--color-on-primary)"
                      stroke-width="2" />
            </svg>
            <h1 id="login-heading">@Localizer["Auth.SignIn"]</h1>
            <p class="login-subtitle">@Localizer["Auth.LoginSubtitle"]</p>
        </header>
        <p class="info-note">@Localizer["Auth.OfflineNotice"]</p>
        <form class="login-form" @onsubmit="SubmitAsync" @onsubmit:preventDefault>
            <div class="form-field">
                <label for="login-user-name">@Localizer["Auth.UserName"]</label>
                <input id="login-user-name"
                       type="text"
                       autocomplete="username"
                       @bind="_userName"
                       disabled="@_busy" />
                @if (_userNameError is not null)
                {
                    <span class="validation-message" role="alert">@_userNameError</span>
                }
            </div>
            <div class="form-field">
                <label for="login-password">@Localizer["Auth.Password"]</label>
                <div class="password-control">
                    <input id="login-password"
                           class="password-input"
                           type="@PasswordInputType"
                           autocomplete="current-password"
                           @bind="_password"
                           disabled="@_busy" />
                    <button type="button"
                            class="button-quiet password-toggle"
                            aria-label="@Localizer[PasswordVisibilityKey]"
                            @onclick="TogglePasswordVisibility"
                            disabled="@_busy">
                        @Localizer[PasswordVisibilityKey]
                    </button>
                </div>
                @if (_passwordError is not null)
                {
                    <span class="validation-message" role="alert">@_passwordError</span>
                }
            </div>
            @if (_errorText is not null)
            {
                <p class="error-banner" role="alert">@_errorText</p>
            }
            <button type="submit" class="action-button login-submit" disabled="@_busy">
                @Localizer[_busy ? "Auth.SigningIn" : "Auth.SignIn"]
            </button>
        </form>
    </div>
    <a class="button-quiet back-link" href="/">@Localizer["Common.Back"]</a>
</section>

@code {
    [Inject]
    private ILocalizer Localizer { get; set; } = default!;

    [Inject]
    private IAsmsApiClient ApiClient { get; set; } = default!;

    [Inject]
    private ErrorTextService ErrorText { get; set; } = default!;

    [Inject]
    private NavigationManager Navigation { get; set; } = default!;

    private string _userName = string.Empty;
    private string _password = string.Empty;
    private string? _userNameError;
    private string? _passwordError;
    private string? _errorText;
    private bool _busy;
    private bool _showPassword;

    private string PasswordInputType => _showPassword ? "text" : "password";

    private string PasswordVisibilityKey =>
        _showPassword ? "Auth.HidePassword" : "Auth.ShowPassword";

    private void TogglePasswordVisibility() => _showPassword = !_showPassword;

    private async Task SubmitAsync()
    {
        if (_busy)
        {
            return;
        }

        _userNameError = string.IsNullOrWhiteSpace(_userName)
            ? Localizer.Get("Validation.Required", Localizer["Auth.UserName"])
            : null;
        _passwordError = string.IsNullOrWhiteSpace(_password)
            ? Localizer.Get("Validation.Required", Localizer["Auth.Password"])
            : null;
        _errorText = null;
        if (_userNameError is not null || _passwordError is not null)
        {
            _password = string.Empty;
            return;
        }

        var password = _password;
        _busy = true;
        try
        {
            var result = await ApiClient.LoginAsync(_userName, password);
            if (result.Succeeded)
            {
                Navigation.NavigateTo("/home");
                return;
            }

            _errorText = ErrorText.ErrorText(result.ErrorCode ?? "Unexpected");
        }
        finally
        {
            _password = string.Empty;
            _busy = false;
        }
    }
}
