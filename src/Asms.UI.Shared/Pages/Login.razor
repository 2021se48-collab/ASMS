@page "/login"
@using Microsoft.AspNetCore.Components.Forms

<section class="page-content login-page" aria-labelledby="login-heading">
    <h1 id="login-heading">@Localizer["Auth.SignIn"]</h1>
    <p>@Localizer["Auth.OfflineNotice"]</p>
    <form @onsubmit="SubmitAsync" @onsubmit:preventDefault>
        <div class="form-field">
            <label for="login-user-name">@Localizer["Auth.UserName"]</label>
            <input id="login-user-name"
                   type="text"
                   autocomplete="username"
                   @bind="_userName"
                   disabled="@_busy" />
            @if (_userNameError is not null)
            {
                <span class="validation-message" role="alert">@_userNameError</span>
            }
        </div>
        <div class="form-field">
            <label for="login-password">@Localizer["Auth.Password"]</label>
            <input id="login-password"
                   type="password"
                   autocomplete="current-password"
                   @bind="_password"
                   disabled="@_busy" />
            @if (_passwordError is not null)
            {
                <span class="validation-message" role="alert">@_passwordError</span>
            }
        </div>
        @if (_errorText is not null)
        {
            <p class="error-banner" role="alert">@_errorText</p>
        }
        <button type="submit" class="action-button" disabled="@_busy">
            @Localizer[_busy ? "Auth.SigningIn" : "Auth.SignIn"]
        </button>
    </form>
    <a class="back-link" href="/">@Localizer["Common.Back"]</a>
</section>

@code {
    [Inject]
    private ILocalizer Localizer { get; set; } = default!;

    [Inject]
    private IAsmsApiClient ApiClient { get; set; } = default!;

    [Inject]
    private ErrorTextService ErrorText { get; set; } = default!;

    [Inject]
    private NavigationManager Navigation { get; set; } = default!;

    private string _userName = string.Empty;
    private string _password = string.Empty;
    private string? _userNameError;
    private string? _passwordError;
    private string? _errorText;
    private bool _busy;

    private async Task SubmitAsync()
    {
        if (_busy)
        {
            return;
        }

        _userNameError = string.IsNullOrWhiteSpace(_userName)
            ? Localizer.Get("Validation.Required", Localizer["Auth.UserName"])
            : null;
        _passwordError = string.IsNullOrWhiteSpace(_password)
            ? Localizer.Get("Validation.Required", Localizer["Auth.Password"])
            : null;
        _errorText = null;
        if (_userNameError is not null || _passwordError is not null)
        {
            _password = string.Empty;
            return;
        }

        var password = _password;
        _busy = true;
        try
        {
            var result = await ApiClient.LoginAsync(_userName, password);
            if (result.Succeeded)
            {
                Navigation.NavigateTo("/home");
                return;
            }

            _errorText = ErrorText.ErrorText(result.ErrorCode ?? "Unexpected");
        }
        finally
        {
            _password = string.Empty;
            _busy = false;
        }
    }
}
